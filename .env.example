# ===== Gemini AI — get a key at https://aistudio.google.com/apikey =====
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# ===== Support email =====
# Your inbox — where support tickets are delivered:
SUPPORT_EMAIL=you@gmail.com
# Sender address shown on emails (must be a verified sender in Brevo):
SMTP_FROM=you@gmail.com

# Option A (recommended, works on Render free): Brevo HTTPS API — https://app.brevo.com/settings/keys/api
BREVO_API_KEY=

# Option B (paid hosts / VPS only — Render free blocks SMTP ports): Gmail SMTP with an App Password
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Port (Render sets this automatically)
PORT=3000
